# ===========================================================================
#  Support Ticket Triage & Resolution Agent  -  environment configuration
# ===========================================================================
#  Copy this file to ".env" and fill in the values.  DO NOT commit .env.
#
#  MINIMUM to run for real:  just GROQ_API_KEY.
#  MINIMUM to run at all:    nothing - leave LLM_PROVIDER=mock and it works
#                            offline with deterministic stub responses.
# ===========================================================================

# --- LLM provider selection -------------------------------------------------
# One of: groq | mock
#   groq  -> uses Groq cloud (needs GROQ_API_KEY below)
#   mock  -> deterministic offline responses (no key, no network) - great for
#            testing the graph, routing, HITL and audit logic.
LLM_PROVIDER=mock

# --- Groq (the training LLM provider) --------------------------------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Chat model id. Options: openai/gpt-oss-20b | openai/gpt-oss-120b |
#                         groq/compound | qwen/qwen3.6-27b
# (Run `python diagnose_groq.py` to list what your key can access.)
GROQ_MODEL=openai/gpt-oss-20b

# --- Embeddings (RAG) -------------------------------------------------------
# Groq does NOT serve embeddings, so we embed locally. No key required.
# One of: local | mock
#   local -> sentence-transformers (downloads model on first run)
#   mock  -> deterministic hash-based vectors (offline, for tests)
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store -----------------------------------------------------------
# One of: chroma | memory
#   chroma -> persistent local Chroma DB
#   memory -> in-process cosine store (no extra deps; used as fallback)
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/.chroma

# --- Arize AI (evaluation / groundedness) ----------------------------------
# Sign up at https://app.arize.com  (Space Settings -> API Key)
# Leave blank to run the local offline evaluator instead.
ARIZE_API_KEY=
ARIZE_SPACE_ID=
ARIZE_PROJECT_NAME=support-ticket-agent

# --- LangSmith (OPTIONAL tracing) ------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=support-ticket-agent

# --- SerpAPI (OPTIONAL web search tool; disabled by default) ---------------
# Not recommended for this project: the safety rule requires KB-only answers.
ENABLE_WEB_SEARCH=false
SERPAPI_API_KEY=
